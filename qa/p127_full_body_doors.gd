extends "res://qa/p105_collision.gd"

func run():
	OS.set_environment("ESCAPE_TUTORIAL_MODE","off")
	OS.set_environment("ESCAPE_DEV_SETTINGS_PATH","user://p127-doors.cfg")
	root.size=Vector2i(1200,720)
	root.content_scale_size=root.size
	game=load("res://scenes/main.tscn").instantiate()
	root.add_child(game)
	await frame()
	game.set_process(false)
	game.fullscreen_ui.set_process(false)
	game.world.admission_filter=Callable()
	game.orders.clear()
	for actor in game.actors: actor.position=Vector2(2300+actor.actor_id*60,2700)
	var main=game.actors[0]
	var world=game.world
	world.update_dorm_doors(false,[])
	for gate in world.access_doors: world.set_access_closed(gate.id,false)
	world._changed(true)
	# Actual reported south dorm wall: paint and collision both start at y1540.
	var before=Vector2(500,1532)
	var closer=Vector2(500,1537)
	check("five_more_pixels_of_visible_floor_are_walkable",world.can_place_circle(closer,8,main,false,false))
	check("sole_cannot_enter_wall",not world.can_place_circle(Vector2(500,1538),8,main,false,false))
	main.position=before
	world.move_actor(main,closer-before)
	check("manual_movement_reaches_sole_contact",main.position.distance_to(closer)<0.01)
	world.move_actor(main,Vector2(0,300))
	check("large_downward_move_cannot_tunnel",main.position.y<=1537.01)
	check("route_uses_same_near_wall_clearance",travel(main,Vector2(400,1537),Vector2(560,1537)))
	check("parallel_swept_feet_are_clear",world.motion_clear(Vector2(400,1537),Vector2(560,1537),main,false,true))
	check("parallel_swept_overlap_is_blocked",not world.motion_clear(Vector2(400,1538),Vector2(560,1538),main,false,true))
	main.position=Vector2(500,1500)
	world.move_actor(main,Vector2(50,250))
	check("diagonal_move_cannot_drill_wall",main.position.y<=1537.01)
	main.position=Vector2(500,1710)
	world.move_actor(main,Vector2(0,-300))
	check("wall_south_face_remains_solid",main.position.y>=1663-0.01)
	main.position=Vector2(150,1460)
	world.move_actor(main,Vector2(-100,0))
	check("side_wall_keeps_eight_pixel_width",main.position.x>=128-0.01)
	var open_door=game.room_visibility.doorways.by_id("dorm-0").visual_rect
	var feet=open_door.get_center()+Vector2(0,-preload("res://scripts/core/actor_footprint.gd").DOOR_BODY.get_center().y)
	check("open_door_still_walks_both_directions",travel(main,feet-Vector2(80,0),feet+Vector2(80,0)) and travel(main,feet+Vector2(80,0),feet-Vector2(80,0)))
	# This row previously admitted the torso but clips the head on the jamb.
	var head_row: float=open_door.position.y+65
	main.position=Vector2(650,head_row)
	check("head_clearance_start_is_walkable",world.can_place_circle(main.position,8,main,false,false))
	world.move_actor(main,Vector2(90,0))
	check("head_overlap_blocks_direct_exit",main.position.x<open_door.position.x)
	main.position=Vector2(740,head_row)
	world.move_actor(main,Vector2(-90,0))
	check("head_overlap_blocks_direct_entry",main.position.x>open_door.end.x)
	var Footprint=preload("res://scripts/core/actor_footprint.gd")
	check("door_detection_includes_head_and_shoulders",Footprint.body_at(Vector2.ZERO).has_point(Vector2(0,-80)) and Footprint.body_at(Vector2.ZERO).has_point(Vector2(22,-30)))
	check("path_rejects_head_clipping_shortcut",not world.motion_clear(Vector2(650,head_row),Vector2(740,head_row),main,false,true))
	for gate in world.dorm_doors:
		var rect: Rect2=world.door_collision_rect(gate.rect)
		var aligned: Vector2=rect.get_center()-Footprint.DOOR_BODY.get_center()
		check(str(gate.id)+"_full_body_passes_both_directions",travel(main,aligned-Vector2(65,0),aligned+Vector2(65,0)) and travel(main,aligned+Vector2(65,0),aligned-Vector2(65,0)))
	main.position=Vector2(2300,2700)
	var leaf: Rect2=world.door_collision_rect(world.access_by_id("workshop-entry").rect)
	# Only the head overlaps this horizontal gate; closure must defer.
	main.position=Vector2(leaf.get_center().x,leaf.end.y+60)
	check("door_occupancy_includes_head",world.body_overlaps_door(main,world.access_by_id("workshop-entry").rect))
	world.set_access_closed("workshop-entry",true)
	check("closing_door_waits_until_head_clears",not world.access_by_id("workshop-entry").closed)
	main.position.y=leaf.end.y+100
	world.set_access_closed("workshop-entry",true)
	check("door_closes_after_whole_character_clears",world.access_by_id("workshop-entry").closed)
	world.set_access_closed("workshop-entry",false)
	main.position=Vector2(650,open_door.position.y-preload("res://scripts/core/actor_footprint.gd").DOOR_BODY.position.y-4)
	world.move_actor(main,Vector2(90,0))
	check("door_jamb_still_blocks_torso_overlap",main.position.x<680)
	main.position=Vector2(650,open_door.end.y-6)
	world.move_actor(main,Vector2(90,0))
	check("door_jamb_still_blocks_shoe_overlap",main.position.x<680)
	main.position=Vector2(2300,2700)
	var controlled=game.room_visibility.doorways.by_id("workshop-entry").visual_rect.get_center()
	world.set_access_closed("workshop-entry",true)
	check("closed_door_still_blocks",not world.motion_clear(controlled-Vector2(0,100),controlled+Vector2(0,180),main,false,true))
	world.set_access_closed("workshop-entry",false)
	# Check transformed rounded corners and mid-segment contact without relying
	# on either the path grid or the micro-stepping movement implementation.
	var obstacle=Rect2(100,100,40,40)
	check("rounded_corner_allows_diagonal_margin",not world._circle_hits_rect(Vector2(93,98),8,obstacle))
	check("rounded_corner_blocks_real_overlap",world._circle_hits_rect(Vector2(94,99),8,obstacle))
	check("swept_edge_blocks_without_endpoint_overlap",world._segment_hits_rect(Vector2(80,98),Vector2(160,98),obstacle))
	check("swept_edge_allows_exact_sole_contact",not world._segment_hits_rect(Vector2(80,97),Vector2(160,97),obstacle))
	main.position=Vector2(500,1537)
	game.room_visibility.tick(1,true)
	game.map_camera.center_on(main.position-Vector2(0,180))
	game.presentation.tick(0)
	game._update_ui()
	if DisplayServer.get_name()!="headless":
		game.fullscreen_ui.fps_badge.hide()
		await frame()
		await frame()
		root.get_texture().get_image().save_png("res://docs/dev/p127/sole-at-wall.png")
	var failed: Array=checks.keys().filter(func(key):return not checks[key])
	FileAccess.open("res://docs/tests/p127-full-body-doors.json",FileAccess.WRITE).store_string(JSON.stringify({"checks":checks,"failed":failed,"sole_contact_y":1537,"foot_radii":[8,3]},"\t"))
	quit(0 if failed.is_empty() else 1)

