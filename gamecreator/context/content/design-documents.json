        "title": "这次怎么逃核心设计",
        "archived": false,
        "createdAt": "2026-10-04T11:34:42.748Z",
        "updatedAt": "2026-10-04T11:34:42.748Z",
        "images": [],
        "references": [
          {
            "id": "3b02fe04-d060-4794-86c5-ab87ead32ee4",
            "blockId": "af8e91e6-e234-4174-b8b1-350b66f5633d",
            "label": "随机技能房间逃脱",
            "target": {
              "module": "玩法设计",
              "id": "a4539d92-4c10-4137-8796-ce73a71e21e5",
              "kind": "design"
            }
